# ─────────────────────────────────────────────────────────────────────────────
# Legacy Builders — environment template. Copy to .env.local for Next.js.
# Never commit real values.
#
# Two places hold configuration:
#   1. Next.js (this file → .env.local locally, Vercel project env in production)
#   2. Convex deployment env (`npx convex env set NAME value` or the Convex dashboard)
# ─────────────────────────────────────────────────────────────────────────────

# ── Next.js ──────────────────────────────────────────────────────────────────
# Written automatically by `npx convex dev`.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Public origin used for canonical URLs, sitemap and OpenGraph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe publishable key (safe for the browser). Leave empty to use bypass payments.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Shared secret between the Next.js intake route handlers and Convex (must match the Convex value).
INTAKE_SHARED_SECRET=

# ── Convex deployment (set with `npx convex env set`) ────────────────────────
# Convex Auth (generate with `npx @convex-dev/auth`)
# SITE_URL=http://localhost:3000
# JWT_PRIVATE_KEY=
# JWKS=

# APP_ENV=development            # "production" enables production guards
# INTAKE_SHARED_SECRET=           # same value as above

# Payments — "mock" (bypass) until Stripe keys are added
# PAYMENTS_PROVIDER=mock          # mock | stripe
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# ALLOW_PAYMENT_BYPASS=false      # only relevant when APP_ENV=production

# Email — "console" (bypass) until Postmark is configured
# EMAIL_PROVIDER=console          # console | postmark
# POSTMARK_SERVER_TOKEN=
# POSTMARK_MESSAGE_STREAM=outbound
# EMAIL_FROM="Legacy Builders <no-reply@example.com>"

# SMS — "console" (bypass) until Twilio keys are added
# SMS_PROVIDER=console            # console | twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=             # or TWILIO_MESSAGING_SERVICE_SID
# TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_WEBHOOK_URL=             # defaults to <CONVEX_SITE_URL>/twilio/inbound

# Lead ingestion
# META_APP_SECRET=
# META_VERIFY_TOKEN=
# META_PAGE_ACCESS_TOKEN=
# META_GRAPH_VERSION=v21.0
# PARTNER_API_SIGNING_SECRET=

# Security
# MFA_ENCRYPTION_KEY=             # base64 of 32 random bytes
# REQUIRE_STAFF_2FA=true

# Development only
# SEED_PASSWORD=
# MOCK_AUTO_RELOAD_OUTCOME=       # "decline" to test the declined auto-reload path
